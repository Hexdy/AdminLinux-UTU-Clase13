# Ejemplo de archivo de configuración para un script. COPIALO y poné TUS valores:
#   cp .env.example mantenimiento.conf
#   chmod 600 mantenimiento.conf          <-- solo tu usuario puede leerlo
# El archivo real está ignorado por .gitignore: NUNCA se sube al repo.
#
# Así se hace de verdad en un script:
#   [[ -r /etc/mantenimiento.conf ]] && source /etc/mantenimiento.conf
# En vez de:
#   API_TOKEN="abc123"        <- hardcodeado en el script = lo lee cualquiera
#                                que tenga permiso de lectura, y queda en el repo.

DIR_LOGS=/var/log/tienda
DIAS_RETENCION=14
TAG_LOGGER=mantenimiento
# API_TOKEN=cambiame        (valor de mentira: nunca pongas el real acá)
